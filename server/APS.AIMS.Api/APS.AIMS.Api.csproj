      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APS.AIMS.Application\APS.AIMS.Application.csproj" />
    <ProjectReference Include="..\APS.AIMS.Infrastructure\APS.AIMS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
